# Twilio Agentic Framework Environment Variables
# Copy this file to .env and update with your actual values

# Environment (dev, stage, or prod)
# This determines the base URLs for Memora and Maestro automatically
ENVIRONMENT=dev

# Memory Service Configuration
MEMORY_SERVICE_SID=mem_service_00000000000000000000000000

# Conversation Service Configuration
CONVERSATION_SERVICE_SID=conv_service_000000000000000000000000

# Twilio Account Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+15551234567

# Optional: Logging Configuration
# LOG_LEVEL=INFO