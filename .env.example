# Twilio Agentic Framework Environment Variables
# Copy this file to .env and update with your actual values

# Memora (Memory Service) Configuration
MEMORA_BASE_URL=https://memory.twilio.com/v1
MEMORY_SERVICE_SID=mem_service_123

# Maestro (Conversation Management) Configuration
MAESTRO_BASE_URL=https://maestro.twilio.com/v1
CONVERSATION_SERVICE_SID=conv_service_123

# Twilio Account Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here

# Optional: Logging Configuration
# LOG_LEVEL=INFO
