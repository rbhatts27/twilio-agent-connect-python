# Twilio Agentic Framework Environment Variables
# Copy this file to .env and update with your actual values

# ============================================================================
# REQUIRED - TAF Core Configuration
# ============================================================================

# Environment (dev, stage, or prod)
# This determines the base URLs for Memora and Maestro automatically
TWILIO_TAF_ENVIRONMENT=prod

# Twilio Account Configuration
TWILIO_TAF_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_TAF_AUTH_TOKEN=your_auth_token_here
TWILIO_TAF_PHONE_NUMBER=+1234567890

# Conversation Service Configuration
TWILIO_TAF_CONVERSATION_SERVICE_SID=ISxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# OPTIONAL - Memory Service Configuration (Twilio Memory/Memora)
# ============================================================================
# Only needed if you have purchased Twilio Memory functionality.
# When provided, TAF will automatically retrieve memory for conversations.

# TWILIO_TAF_MEMORY_STORE_ID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_TAF_MEMORY_API_KEY=your_api_key_here
# TWILIO_TAF_MEMORY_API_TOKEN=your_api_token_here
# TWILIO_TAF_TRAIT_GROUPS=Contact,Preferences

# ============================================================================
# OPTIONAL - Additional Configuration
# ============================================================================

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# TWILIO_TAF_LOG_LEVEL=INFO

# Knowledge API Configuration
# Comma-separated list of Knowledge IDs to use with examples
# TWILIO_TAF_KNOWLEDGE_IDS=KN123abc,KN456def

# OpenAI API Key (required for examples using OpenAI)
TWILIO_TAF_OPENAI_API_KEY=your_openai_api_key_here

# Voice Channel Configuration (required for voice examples)
# Public domain for ngrok or your domain (without port)
# Example: abc123.ngrok.io (from ngrok) or your-domain.com
TWILIO_TAF_VOICE_PUBLIC_DOMAIN=your-ngrok-domain.ngrok.io

# Flex Escalation Configuration (required for escalation examples)
# TWILIO_TAF_VOICE_HANDOFF_FLEX_WORKFLOW_SID=WWxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Enable Active Hydration for Voice (set to true to enable)
TWILIO_TAF_ENABLE_VOICE_ACTIVE_HYDRATION=true