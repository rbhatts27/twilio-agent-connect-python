# Twilio Agentic Framework Environment Variables
# Copy this file to .env and update with your actual values

# Environment (dev, stage, or prod)
# This determines the base URLs for Memora and Maestro automatically
ENVIRONMENT=dev

# Memory Service Configuration
MEMORY_STORE_ID=mem_service_00000000000000000000000000
TWILIO_API_KEY=your_api_key_here
TWILIO_API_TOKEN=your_api_token_here

# Conversation Service Configuration
CONVERSATION_SERVICE_SID=conv_service_000000000000000000000000

# Twilio Account Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Knowledge API Configuration (optional)
# Comma-separated list of Knowledge IDs to use with examples
# KNOWLEDGE_IDS=KN123abc,KN456def

# Optional: Logging Configuration
# LOG_LEVEL=INFO

OPENAI_API_KEY=your_openai_api_key_here

# REQUIRED: Public domain for ngrok or your domain (without port)
# Example: abc123.ngrok.io (from ngrok) or your-domain.com
VOICE_PUBLIC_DOMAIN=your-ngrok-domain.ngrok.io
VOICE_HANDOFF_FLEX_WORKFLOW_SID=WW000000000000000000000000000000