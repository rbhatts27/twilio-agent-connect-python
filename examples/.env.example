# Twilio Agentic Framework Environment Variables
# Copy this file to .env and update with your actual values

# Memora (Memory Service) Configuration
MEMORA_BASE_URL=https://kiran.ngrok.io
MEMORY_SERVICE_SID=mem_service_00000000000000000000000000

# Maestro (Conversation Management) Configuration
MAESTRO_BASE_URL=https://maestro.twilio.com/v1
CONVERSATION_SERVICE_SID=conv_service_000000000000000000000000

# Twilio Account Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Optional: Logging Configuration
# LOG_LEVEL=INFO

OPENAI_API_KEY=your_openai_api_key_here