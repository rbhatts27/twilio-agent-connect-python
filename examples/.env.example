# Twilio Agent Connect Environment Variables
# Copy this file to .env and update with your actual values

# ============================================================================
# REQUIRED - TAC Core Configuration
# ============================================================================

# Environment (dev, stage, or prod)
# This determines the base URLs for Memora and Maestro automatically
TWILIO_TAC_ENVIRONMENT=prod

# Twilio Account Configuration
TWILIO_TAC_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_TAC_AUTH_TOKEN=your_auth_token_here

# Conversation Service Configuration
TWILIO_TAC_CONVERSATION_SERVICE_SID=conv_configuration_0000000000000000000000000

# ============================================================================
# OPTIONAL - Twilio Phone Number (Required for SMS channel)
# ============================================================================
# TWILIO_TAC_PHONE_NUMBER=+1234567890

# ============================================================================
# OPTIONAL - Memory Service Configuration (Twilio Memory/Memora)
# ============================================================================
# Only needed if you have purchased Twilio Memory functionality.
# When provided, TAC will automatically retrieve memory for conversations.

# TWILIO_TAC_MEMORY_STORE_ID=mem_store_00000000000000000000000000
# TWILIO_TAC_MEMORY_API_KEY=your_api_key_here
# TWILIO_TAC_MEMORY_API_TOKEN=your_api_token_here
# TWILIO_TAC_TRAIT_GROUPS=Contact
# TWILIO_TAC_KNOWLEDGE_BASE_ID=know_knowledgebase_00000000000000000000000000
# ============================================================================
# OPTIONAL - Additional Configuration
# ============================================================================

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# TWILIO_TAC_LOG_LEVEL=INFO

# OpenAI API Key (required for examples using OpenAI)
TWILIO_TAC_OPENAI_API_KEY=your_openai_api_key_here

# Voice Channel Configuration (required for voice examples)
# Public domain for ngrok or your domain (without port)
# Example: abc123.ngrok.io (from ngrok) or your-domain.com
TWILIO_TAC_VOICE_PUBLIC_DOMAIN=your-ngrok-domain.ngrok.io

# Flex Escalation Configuration (required for escalation examples)
# TWILIO_TAC_VOICE_HANDOFF_FLEX_WORKFLOW_SID=WWxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Enable Active Hydration for Voice (set to true to enable)
TWILIO_TAC_ENABLE_VOICE_ACTIVE_HYDRATION=true
